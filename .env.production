# Environment: PRODUCTION
PROJECT_NAME=internet-mlj
PROJECT_BASE_URL=admin.manteslajolie.fr
PROJECT_PORT=8000

# User mapping for Docker containers
MY_UID=1000
MY_GID=1000

# Database
MARIADB_TAG=11.4-3.32.2
DB_NAME=drupal_prod_internet
DB_USER=drupal_prod_internet
DB_PASSWORD=CHANGEME_PRODUCTION_SECURE_PASSWORD
DB_ROOT_PASSWORD=CHANGEME_ROOT_PRODUCTION_SECURE_PASSWORD
DB_HOST=mariadb
DB_PORT=3306
DB_DRIVER=mysql

# PHP - Production optimized
PHP_TAG=8.3-4.69.2
DRUPAL_TAG=11-8.3-4.85.4
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_REALPATH_CACHE_SIZE=4096K
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256

# Nginx
NGINX_TAG=1.29-5.44.2
NGINX_LOG_LEVEL=error
SERVER_NAME=prod-admin.manteslajolie.fr

# Redis
REDIS_TAG=7-5.0.3

# Solr
SOLR_TAG=8-4.17.2
SOLR_CONFIG_SET=drupal-11.1.x